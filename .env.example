# Yearbook environment. Copy to .env (gitignored); mise loads it automatically for host development.
# The container stack (docker compose --profile app) reads only the keys marked [compose] from your shell.

# ---------------------------------------------------------------------------
# AI assistant (OpenAI).  [compose]
# ---------------------------------------------------------------------------
# Your API key from https://platform.openai.com/api-keys. Without it the app works fully,
# search still works, and the assistant answers "not set up yet".
OPENAI_API_KEY=

# Exact model id for the assistant's planning and tool calls. Leave empty to auto-pick the newest
# GPT-6 family model (falls back to GPT-5 only if the account has no GPT-6 access).
OPENAI_MODEL=gpt-6-luna

# Model for the one user-initiated "describe this photo" call (the only place a photo leaves the
# server). Defaults to OPENAI_MODEL. Set a stronger vision model here if you want, e.g. gpt-6-sol.
OPENAI_VISION_MODEL=

# Only for proxies or compatible gateways; leave empty for api.openai.com
OPENAI_BASE_URL=

# LangSmith tracing of every agent turn (optional).  [compose]
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=yearbook

# ---------------------------------------------------------------------------
# Databases (host development; the container stack uses its own internal addresses)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://yearbook:yearbook@localhost:5432/yearbook?sslmode=disable
TEST_DATABASE_URL=postgres://yearbook:yearbook@localhost:5432/yearbook_test?sslmode=disable
WORKER_TEST_DATABASE_URL=postgres://yearbook:yearbook@localhost:5432/yearbook_test_worker?sslmode=disable
# Password of the read-only role the assistant's SQL tool uses (created by `ybctl migrate`)
AGENT_DB_PASSWORD=agent-ro-dev

# ---------------------------------------------------------------------------
# Object storage: SeaweedFS in dev, Cloudflare R2 or Hetzner Object Storage in production
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:8333
# Browser-facing endpoint for presigned upload URLs; only differs from S3_ENDPOINT inside Compose/Kubernetes
S3_PRESIGN_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=yearbook
S3_SECRET_KEY=yearbooksecret
S3_FORCE_PATH_STYLE=true
S3_BUCKET_PRIVATE=yearbook-private
S3_BUCKET_PUBLIC=yearbook-public
# Where browsers load thumbnails from (the CDN in production)
PUBLIC_BASE_URL=http://localhost:8333/yearbook-public

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_ADDR=:8080
WEB_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
COOKIE_SECURE=false
SESSION_SECRET=dev-only-change-me-32-bytes-minimum!!
# Account allowed to import from server-side folders (ybctl import, POST /imports kind=folder)
OPERATOR_EMAIL=demo@yearbook.local

# Internal service addresses the API talks to
ML_URL=http://localhost:8090
AGENT_URL=http://localhost:8091
MCP_URL=http://localhost:8080/mcp
SANDBOX_URL=http://localhost:8092

# ---------------------------------------------------------------------------
# Mail: Mailpit in dev (http://localhost:8025). Production: Resend / Postmark SMTP + your domain.
# ---------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Yearbook <hello@yearbook.local>"
# SMTP_USER= / SMTP_PASSWORD= for a real provider

# ---------------------------------------------------------------------------
# Workers (ML models download on first run into the cache dirs)
# ---------------------------------------------------------------------------
WORKER_TAGS_ENABLED=true          # Florence-2 captions/OCR; set false on slow machines  [compose]
HF_HOME=apps/worker/.cache/hf
INSIGHTFACE_HOME=apps/worker/.cache/insightface

# ---------------------------------------------------------------------------
# Sandbox (agent-written code). Host dev: needs Docker and the sandbox image (mise run sandbox).
# ---------------------------------------------------------------------------
SANDBOX_MAX_PARALLEL=2
# Production: SANDBOX_RUNTIME=runsc (gVisor)

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
API_INTERNAL_URL=http://localhost:8080/api/v1
PUBLIC_WEB_ORIGIN=http://localhost:3000
